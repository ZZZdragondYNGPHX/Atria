{
  "name": "@atria-dev/mcp",
  "version": "0.3.0",
  "description": "Local MCP bridge for Atria contracts, source-aware API discovery and real browser previews",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "bin": {
