<section node-id="panel" bind:class="component.fontClass" aria-label="旅舍信息与行动">
 <header node-id="panel-header" class="panel-header"><div node-id="panel-heading-wrap"><h2 node-id="panel-heading" bind:text="component.heading" /><p node-id="panel-intro" bind:text="component.intro" /></div><button node-id="close" aria-label="关闭并返回场景">返回场景</button></header>
 <div node-id="panel-content" class="panel-content">
  <img node-id="detail-image" class="detail-image" if="component.hasImage" bind:media="component.detailImage" alt="对应已获知记录的物件插画；原文与来源见下方" />
  <section node-id="preview" class="preview" if="component.preview"><h3 node-id="preview-title" bind:text="component.previewTitle" /><p node-id="preview-cost" class="cost" bind:text="component.previewCost" /><p node-id="preview-after" bind:text="component.previewAfter" /><p node-id="preview-note" bind:text="component.previewNote" /><div node-id="confirm-actions" class="row"><button node-id="cancel-preview" bind:disabled="component.busy">先不做 / 修改打算</button><button node-id="confirm" class="primary" bind:disabled="component.confirmDisabled" bind:text="component.confirmLabel" /></div></section>
  <section node-id="settings" class="settings" if="component.settings"><h3 node-id="settings-title">阅读与声音</h3><p node-id="settings-sound" bind:text="component.sound" /><div node-id="settings-actions" class="row"><button node-id="sound-enable">启用声音</button><button node-id="sound-mute">切换静音</button><button node-id="ambience-down">环境音 −</button><button node-id="ambience-up">环境音 +</button><button node-id="effects-down">效果音 −</button><button node-id="effects-up">效果音 +</button><button node-id="font-normal">标准文字</button><button node-id="font-large">大字 / 宽行距</button><button node-id="reduce-motion">减少动态效果</button></div><h3 node-id="system-title">进度与恢复</h3><div node-id="system-actions" class="row"><button node-id="save-now">创建新存档</button><button node-id="open-saves">选择存档</button><button node-id="open-log">只读历史</button><button node-id="export-help">导入与导出在哪里</button><button node-id="recover">恢复连接</button><button node-id="reload">重新加载界面</button><button node-id="new-game">再开始一局</button><button node-id="exit">退出作品</button></div></section>
  <section node-id="person" if="component.person"><h3 node-id="chat-title">在这里聊几句</h3><label node-id="chat-label" for="fog-chat">普通闲聊，不改变关键安排</label><textarea node-id="chat-draft" id="fog-chat" rows="3" bind:value="component.chatDraft" /><button node-id="chat-history">回看交谈回应</button><button node-id="chat-send" bind:disabled="component.busy">说给对方听</button><p node-id="chat-reply" class="body" bind:text="component.chatReply" /></section>
  <section node-id="notes-tools" class="row" if="component.notes"><label node-id="filter-label" for="fog-filter">查找已获知内容</label><input node-id="search" id="fog-filter" bind:value="component.search" /><button node-id="filter">筛选</button><button node-id="clear-filter">清除筛选</button><button node-id="notes-all">全部</button><button node-id="notes-active">进行中</button><button node-id="notes-messages">公共消息</button><button node-id="notes-clues">已知线索与说法</button><button node-id="hint">想一想 · 逐层提示</button></section>
  <p node-id="hint-content" bind:text="component.hint" /><p node-id="read-only" if="component.readOnly">历史只读 · 不能从这里改变世界。返回场景继续当前安排。</p>
  <div node-id="row-events"><div node-id="panel-rows" class="panel-rows" each="component.rows" item-key="id"><article node-id="panel-row" class="panel-row"><h3 node-id="row-heading" bind:text="item.label" /><p node-id="row-meta" class="meta" bind:text="item.meta" /><p node-id="row-text" bind:text="item.text" /><button node-id="row-action" bind:data-value="item.id" bind:disabled="item.disabled">查看 / 选择</button></article></div></div>
  <p node-id="panel-empty" if="component.empty">这里尚无记录，或没有匹配内容。可以返回场景或清除筛选。</p>
 </div>
 <footer node-id="panel-status" class="panel-status" aria-live="polite"><p node-id="panel-notice" bind:text="component.notice" /><strong node-id="panel-error" class="error" bind:text="component.error" /><button node-id="panel-refresh">核对当前状态</button><button node-id="panel-stop" if="component.busy">停止请求，随后核对</button></footer>
</section>
