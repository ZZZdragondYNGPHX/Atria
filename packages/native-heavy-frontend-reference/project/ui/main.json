                },
                {
                  "value": "church",
                  "label": "Church"
                },
                {
                  "value": "schedule",
                  "label": "Schedule"
                },
                {
                  "value": "phone",
                  "label": "Phone"
                },
                {
                  "value": "people",
                  "label": "People"
                }
