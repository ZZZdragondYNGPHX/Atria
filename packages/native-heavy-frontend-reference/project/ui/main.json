{
  "schemaVersion": 2,
  "stateVersion": 1,
  "localState": {
    "player_name": {
      "type": "string",
      "default": "",
      "scope": "session",
      "required": true,
      "minLength": 1,
      "maxLength": 40
    },
    "section": {
      "type": "string",
      "default": "story",
      "scope": "session",
      "enum": [
        "story",
        "church",
        "schedule",
        "phone",
        "people"
      ]
    },
    "church_section": {
      "type": "string",
      "default": "overview",
      "scope": "session",
      "enum": [
        "overview",
        "facilities",
        "decrees",
        "projects",
        "opportunities"
      ]
    }
  },
  "selectors": {
    "story_active": "ui.section == \"story\"",
    "church_active": "ui.section == \"church\"",
    "schedule_active": "ui.section == \"schedule\"",
    "phone_active": "ui.section == \"phone\"",
    "people_active": "ui.section == \"people\"",
    "church_overview_active": "ui.church_section == \"overview\"",
    "church_facilities_active": "ui.church_section == \"facilities\"",
    "church_decrees_active": "ui.church_section == \"decrees\"",
    "church_projects_active": "ui.church_section == \"projects\"",
    "church_opportunities_active": "ui.church_section == \"opportunities\"",
    "caretaker_is_leader": "world.church.positions.leader == \"actor_b48a53176eb663a1af411fb6f8638d66\""
  },
  "actions": {
    "confirm_opening": {
      "steps": [
        {
          "op": "opening.confirm"
        }
      ]
    },
    "finish_opening": {
      "steps": [
        {
          "op": "ui.set",
          "path": "ui.section",
          "value": "story"
        }
      ]
    },
    "show_story": {
      "steps": [
        {
          "op": "ui.set",
          "path": "ui.section",
          "value": "story"
        }
      ]
    },
    "show_church": {
      "steps": [
        {
          "op": "ui.set",
          "path": "ui.section",
          "value": "church"
        }
      ]
    },
    "show_schedule": {
      "steps": [
        {
          "op": "ui.set",
          "path": "ui.section",
          "value": "schedule"
        }
      ]
    },
    "show_phone": {
      "steps": [
        {
          "op": "ui.set",
          "path": "ui.section",
          "value": "phone"
        }
      ]
    },
    "show_people": {
      "steps": [
        {
          "op": "ui.set",
          "path": "ui.section",
          "value": "people"
        }
      ]
    },
    "church_overview": {
      "steps": [
        {
          "op": "ui.set",
          "path": "ui.church_section",
          "value": "overview"
        }
      ]
    },
    "church_facilities": {
      "steps": [
        {
          "op": "ui.set",
          "path": "ui.church_section",
          "value": "facilities"
        }
      ]
    },
    "church_decrees": {
      "steps": [
        {
          "op": "ui.set",
          "path": "ui.church_section",
          "value": "decrees"
        }
      ]
    },
    "church_projects": {
      "steps": [
        {
          "op": "ui.set",
          "path": "ui.church_section",
          "value": "projects"
        }
      ]
    },
    "church_opportunities": {
      "steps": [
        {
          "op": "ui.set",
          "path": "ui.church_section",
          "value": "opportunities"
        }
      ]
    },
    "build_outreach_desk": {
      "steps": [
        {
          "op": "command.dispatch",
          "commandId": "church.purchase-outreach-desk",
          "args": {}
        }
      ]
    },
    "enact_community_first": {
      "steps": [
        {
          "op": "command.dispatch",
          "commandId": "church.enact-community-first",
          "args": {}
        }
      ]
    },
    "enact_open_books": {
      "steps": [
        {
          "op": "command.dispatch",
          "commandId": "church.enact-open-books",
          "args": {}
        }
      ]
    },
    "promote_church": {
      "steps": [
        {
          "op": "command.dispatch",
          "commandId": "church.promote-level",
          "args": {}
        }
      ]
    }
  },
  "views": [
    {
      "id": "opening",
      "surface": "chat.header",
      "mount": "always",
      "root": {
        "id": "opening_form",
        "type": "form",
        "events": {
          "submit": "confirm_opening"
        },
        "children": [
          {
            "id": "opening_title",
            "type": "text",
            "props": {
              "text": "Begin a new story"
            }
          },
          {
            "id": "opening_copy",
            "type": "text",
            "props": {
              "text": "Choose the name used by this reference session. Story is the default home."
            }
          },
          {
            "id": "player_name",
            "type": "input",
            "model": "ui.player_name",
            "props": {
              "label": "Your name",
              "placeholder": "Traveler"
            }
          },
          {
            "id": "opening_submit",
            "type": "button",
            "props": {
              "text": "Enter Story",
              "submit": true
            }
          }
        ]
      }
    },
    {
