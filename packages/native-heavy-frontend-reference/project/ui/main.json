                      }
                    }
                  },
                  {
                    "id": "decree_open_books_active",
                    "type": "badge",
                    "props": {
                      "text": "Open Books · Active"
                    },
                    "bindings": {
                      "hidden": {
                        "expr": "world.church.decrees.openBooks == false"
                      }
                    }
                  },
                  {
                    "id": "decree_open_books_copy",
                    "type": "text",
                    "props": {
                      "text": "Open Books · requires Community First"
                    },
                    "bindings": {
                      "hidden": {
                        "expr": "world.church.decrees.openBooks == true"
                      }
                    }
                  },
                  {
                    "id": "decree_open_books_button",
                    "type": "button",
                    "props": {
                      "text": "Enact Open Books"
                    },
                    "events": {
                      "click": "enact_open_books"
                    },
                    "bindings": {
                      "hidden": {
                        "expr": "world.church.decrees.openBooks == true"
                      },
                      "disabled": {
                        "expr": "world.church.decrees.communityFirst == false"
                      }
                    }
                  }
                ]
              },
              {
                "id": "church_projects_panel",
                "type": "stack",
                "bindings": {
                  "hidden": {
                    "expr": "selectors.church_projects_active == false"
                  }
                },
                "children": [
                  {
                    "id": "projects_title",
                    "type": "text",
                    "props": {
                      "text": "Projects"
                    }
                  },
                  {
                    "id": "projects_list",
                    "type": "repeat",
                    "source": "projection.church_projects.items",
                    "key": "item.id",
                    "pageSize": 12,
                    "emptyText": "No projects",
                    "children": [
                      {
                        "id": "project_card",
                        "type": "stack",
                        "children": [
                          {
                            "id": "project_title",
                            "type": "text",
                            "bindings": {
                              "text": {
                                "template": "{{item.data.template_id}} · {{item.data.status}}"
                              }
                            }
                          },
                          {
                            "id": "project_progress_text",
                            "type": "text",
                            "bindings": {
                              "text": {
                                "template": "Progress {{item.data.progress}} / {{item.data.target}} · due tick {{item.data.due_tick}}"
                              }
                            }
                          },
                          {
                            "id": "project_progress",
                            "type": "progress",
                            "props": {
                              "max": 100
                            },
                            "bindings": {
                              "value": {
                                "expr": "min(100, round(item.data.progress * 100 / max(1, item.data.target)))"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "id": "church_opportunities_panel",
                "type": "stack",
                "bindings": {
                  "hidden": {
                    "expr": "selectors.church_opportunities_active == false"
                  }
                },
                "children": [
                  {
                    "id": "opportunities_title",
                    "type": "text",
                    "props": {
                      "text": "Opportunities"
                    }
                  },
                  {
                    "id": "opportunities_list",
                    "type": "repeat",
                    "source": "projection.church_opportunities.items",
                    "key": "item.id",
                    "pageSize": 12,
                    "emptyText": "No opportunities",
                    "children": [
                      {
                        "id": "opportunity_card",
                        "type": "stack",
                        "children": [
                          {
                            "id": "opportunity_title",
                            "type": "text",
                            "bindings": {
                              "text": {
                                "template": "{{item.data.title}} · {{item.data.status}}"
                              }
                            }
                          },
                          {
                            "id": "opportunity_summary",
                            "type": "text",
                            "bindings": {
                              "text": {
                                "template": "{{item.data.summary}}"
                              }
                            }
                          },
                          {
                            "id": "opportunity_effects",
                            "type": "text",
                            "bindings": {
                              "text": {
                                "template": "Money {{item.data.money_delta}} · Followers {{item.data.follower_delta}} · Reputation {{item.data.reputation_delta}}"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "schedule_page",
            "type": "stack",
            "bindings": {
              "hidden": {
                "expr": "selectors.schedule_active == false"
              }
            },
            "children": [
              {
                "id": "schedule_title",
                "type": "text",
                "props": {
                  "text": "Schedule"
                }
              },
              {
                "id": "schedule_clock",
                "type": "badge",
                "bindings": {
                  "text": {
                    "template": "Day {{world.calendar.day}} · Game Clock minute {{temporal.world[0].tick % 1440}}"
                  }
                }
              },
              {
                "id": "schedule_copy",
                "type": "text",
                "props": {
                  "text": "The timeline uses the Host Lifecycle clock. Confirmed actions remain Session Application records; no duplicate time state is stored here."
                }
              },
              {
                "id": "schedule_status",
                "type": "badge",
                "bindings": {
                  "text": {
                    "template": "Scheduled records {{length(projection.schedule.items)}}"
                  }
                }
              },
              {
                "id": "schedule_timeline",
                "type": "repeat",
                "source": "projection.schedule.items",
                "key": "item.id",
                "pageSize": 24,
                "emptyText": "No scheduled items",
                "children": [
                  {
                    "id": "schedule_record",
                    "type": "stack",
                    "children": [
                      {
                        "id": "schedule_record_title",
                        "type": "text",
                        "bindings": {
                          "text": {
                            "template": "{{item.data.title}} · {{item.data.status}}"
                          }
                        }
                      },
                      {
                        "id": "schedule_record_time",
                        "type": "text",
                        "bindings": {
                          "text": {
                            "template": "Day {{floor(item.data.start_tick / 1440) + 1}} · minute {{item.data.start_tick % 1440}}–{{item.data.end_tick % 1440}}"
                          }
                        }
                      },
                      {
                        "id": "schedule_record_policy",
                        "type": "badge",
                        "bindings": {
                          "text": {
                            "template": "{{item.data.policy}} · {{item.data.operation_kind}}"
                          }
                        }
                      },
                      {
                        "id": "schedule_record_location",
                        "type": "text",
                        "bindings": {
                          "text": {
                            "template": "{{item.data.location}}"
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "schedule_due_note",
                "type": "text",
                "props": {
                  "text": "Due interactions appear here when declared by later communication features; Phase 4 does not create a second scheduler."
                }
              }
            ]
          },
          {
            "id": "phone_page",
            "type": "stack",
            "bindings": {
              "hidden": {
                "expr": "selectors.phone_active == false"
              }
            },
            "children": [
              {
                "id": "phone_title",
                "type": "text",
                "props": {
                  "text": "Phone"
                }
              },
              {
                "id": "phone_copy",
                "type": "text",
                "props": {
                  "text": "Messages, Social, and Mail are ready for future Native communication records."
                }
              },
              {
                "id": "phone_status",
                "type": "badge",
                "props": {
                  "text": "No unread items"
                }
              }
            ]
          },
          {
            "id": "people_page",
            "type": "stack",
            "bindings": {
              "hidden": {
                "expr": "selectors.people_active == false"
              }
            },
            "children": [
              {
                "id": "people_title",
                "type": "text",
                "props": {
                  "text": "People"
                }
              },
              {
                "id": "people_identity",
                "type": "text",
                "props": {
                  "text": "Caretaker"
                }
              },
              {
                "id": "people_role",
                "type": "badge",
                "props": {
                  "text": "Church leader · Narrative anchor"
                },
                "bindings": {
                  "hidden": {
                    "expr": "selectors.caretaker_is_leader == false"
                  }
                }
              },
              {
                "id": "people_relationship",
                "type": "text",
                "bindings": {
                  "text": {
                    "template": "Relationship · {{world.people.caretaker.relationship}}"
                  }
                }
              },
              {
                "id": "people_current_title",
                "type": "text",
                "props": {
                  "text": "Current status"
                }
              },
              {
                "id": "people_current",
                "type": "repeat",
                "source": "projection.people_event.items",
                "key": "item.id",
                "pageSize": 4,
                "emptyText": "Not currently in an Event",
                "children": [
                  {
                    "id": "people_current_event",
                    "type": "text",
                    "bindings": {
                      "text": {
                        "template": "{{item.data.title}} · {{item.data.location}} · {{item.data.status}}"
                      }
                    }
                  }
                ]
              },
              {
                "id": "people_schedule_title",
                "type": "text",
                "props": {
                  "text": "Today schedule"
                }
              },
              {
                "id": "people_schedule",
                "type": "repeat",
                "source": "projection.people_schedule.items",
                "key": "item.id",
                "pageSize": 12,
                "emptyText": "No scheduled work",
                "children": [
                  {
                    "id": "people_schedule_item",
                    "type": "text",
                    "bindings": {
                      "text": {
                        "template": "{{item.data.title}} · minute {{item.data.start_tick % 1440}}–{{item.data.end_tick % 1440}} · {{item.data.status}}"
                      }
                    }
                  }
                ]
              },
              {
                "id": "people_recent_title",
                "type": "text",
                "props": {
                  "text": "Relevant recent information"
                }
              },
              {
                "id": "people_recent",
                "type": "repeat",
                "source": "projection.people_recent.items",
                "key": "item.id",
                "pageSize": 4,
                "emptyText": "No recent narrative information",
                "children": [
                  {
                    "id": "people_recent_item",
                    "type": "text",
                    "bindings": {
                      "text": {
                        "template": "{{item.data.content}}"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "opening": {
    "initial": "welcome",
    "steps": [
      {
        "id": "welcome",
        "view": "opening",
        "fields": [
          "ui.player_name"
        ],
        "next": []
      }
    ],
    "confirmAction": "finish_opening"
  },
  "conversation": {
    "mode": "reader",
    "profile": "novel"
  },
  "messageBlocks": {
    "scene_marker": {
      "version": 1,
      "maxInstances": 2,
      "dataSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "label",
          "detail"
        ]
      },
      "document": {
        "schemaVersion": 2,
        "stateVersion": 1,
        "views": [
          {
            "id": "message",
            "surface": "chat.footer",
            "mount": "always",
            "root": {
              "id": "scene_marker_block",
              "type": "stack",
              "children": [
                {
                  "id": "scene_marker_label",
                  "type": "badge",
                  "bindings": {
                    "text": {
                      "template": "{{block.label}}"
                    }
                  }
                },
                {
                  "id": "scene_marker_detail",
                  "type": "text",
                  "bindings": {
                    "text": {
                      "template": "{{block.detail}}"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
