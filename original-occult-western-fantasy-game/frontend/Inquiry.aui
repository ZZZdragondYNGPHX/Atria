<template>
<main node-id="root" class="register" lang="en">
 <button node-id="skipContent" class="skip">Skip to the current section</button><aside node-id="cover" class="cover">
  <div node-id="brand" class="brand"><span node-id="brand-mark" aria-hidden="true" class="registration-mark">E</span><p node-id="brand-name"><span node-id="brand-place">Eastbank</span><br node-id="brand-break"/><span node-id="brand-title">Field register</span></p></div>
  <nav node-id="nav" aria-label="Field register">
   <button node-id="go_notes" bind:aria-current="component.navNotes" value="notes">Field notes</button><button node-id="go_chronicle" bind:aria-current="component.navChronicle" value="timeline">Chronicle</button><button node-id="go_arrangements" bind:aria-current="component.navArrangements" value="identity">Arrangements</button>
  </nav>
  <p node-id="cover-note" class="cover-note">Independent Civil Verifier<br node-id="cover-br"/>Provenance is not proof of a cause.</p>
 </aside>
 <section node-id="folio" class="folio">
  <header node-id="header" class="masthead"><p node-id="identity" bind:text="component.identity"/><div node-id="mast-actions"><span node-id="time" bind:text="component.time"/><button node-id="advanceTime">Advance time</button><button node-id="refresh" class="quiet">Refresh record</button></div></header>
  <p node-id="orientation" class="prose orientation" bind:text="component.orientation"/><label node-id="section-label" for="register-section">Section</label><select node-id="selectSection" on:change="historyReadBegin" id="register-section" bind:value="component.tab"><option node-id="section-option" each="component.sections" item-key="id" bind:value="item.id" bind:text="item.label"/></select>
  <div node-id="loading" if="component.loading" role="status" class="feedback">Opening the player-safe record…</div>
  <div node-id="error" if="component.error" role="alert" class="feedback error"><p node-id="error-copy" bind:text="component.error"/><button node-id="retryAction" if="component.retry">Retry original request</button></div>
  <p node-id="notice" role="status" aria-live="polite" class="notice" bind:text="component.notice"/>
  <div node-id="notes" if="component.isNotes" class="section">
   <div node-id="opening-title" class="title-block"><h1 node-id="heading" tabindex="-1" bind:text="component.heading"/><p node-id="matter" class="deck" bind:text="component.matter"/></div>
   <section node-id="creation" if="component.creation" class="creation"><h2 node-id="creation-heading">An ordinary life, first.</h2><p node-id="creation-copy">No class, special ancestry or power is selected here. Your living Anchor is a person, not a resource.</p><ol node-id="steps" class="steps"><li node-id="step1">Identity</li><li node-id="step2">Origin</li><li node-id="step3">Prior life</li><li node-id="step4">Faith</li><li node-id="step5">Anchor</li><li node-id="step6">Reason</li></ol><p node-id="stepText" class="step-current" bind:text="component.stepText"/><button node-id="continueCreation" class="primary">Continue character creation</button></section>
   <section node-id="conversation" class="conversation" aria-label="Committed conversation"><article node-id="message" each="component.messages" item-key="id" class="message"><p node-id="message-role" class="byline" bind:text="item.role"/><div node-id="message-text" class="prose" bind:prose="item.text"/></article><button node-id="nextMessages" class="quiet">Next conversation page</button></section>
   <p node-id="reply-reason" class="source" bind:text="component.replyReason"/><button node-id="replyRetry" bind:disabled="component.replyDisabled">Retry current committed reply</button><section node-id="composer-section" class="composer"><label node-id="composer-label" for="composer">Continue in your own words</label><textarea node-id="composerInput" id="composer" name="player-action" autocomplete="off" rows="3" bind:value="component.draft" placeholder="What do you examine, ask or attempt?"/><div node-id="composer-actions" class="button-row"><button node-id="ask" class="primary" bind:disabled="component.composerDisabled">Send to Composer</button><button node-id="cancel" class="quiet">Stop generation</button></div><small node-id="composer-help">Atria resolves the action before narration. A failed narration does not publish authority.</small></section>
  </div>
  <section node-id="evidence-page" if="component.isEvidence" class="section"><div node-id="evidence-title" class="title-block"><h1 node-id="ev-heading" tabindex="-1">The evidence register</h1><p node-id="ev-intro" class="deck">Inspect what you hold. Keep what is observed separate from what is said, inferred or proposed.</p></div>
   <label node-id="search-label" for="evidence-search">Find within acquired records</label><input node-id="search" id="evidence-search" name="acquired-evidence-search" autocomplete="off" type="search" bind:value="component.search" placeholder="Search title, source or text"/>
   <div node-id="evidence-layout" class="evidence-layout"><div node-id="evidence-list" class="record-list"><article node-id="ev-row" each="component.evidence" item-key="id" class="record"><p node-id="ev-kind" class="semantic" bind:text="item.kind"/><button node-id="selectEvidence" on:click="inspect" class="record-title" bind:text="item.label"/><p node-id="ev-source" class="source" bind:text="item.source"/><p node-id="ev-text" class="record-preview" bind:text="item.text"/><details node-id="ev-full"><summary node-id="ev-full-summary">Read full record</summary><p node-id="ev-full-text" class="prose" bind:text="item.text"/><p node-id="ev-full-source" bind:text="item.source"/><p node-id="ev-full-custody" bind:text="item.custody"/></details></article></div>
   <aside node-id="detail" if="component.hasDetail" class="detail"><button node-id="closeDetail" class="quiet">Close record</button><p node-id="detail-kind" class="semantic" bind:text="component.detail.kind"/><h2 node-id="detail-title" bind:text="component.detail.label"/><p node-id="detail-text" class="prose" bind:text="component.detail.text"/><dl node-id="provenance"><dt node-id="source-term">Source / attribution</dt><dd node-id="source-desc" bind:text="component.detail.source"/><dt node-id="custody-term">Custody / status</dt><dd node-id="custody-desc" bind:text="component.detail.custody"/></dl><h3 node-id="links-title">Known relations</h3><p node-id="graph-help">Relations link acquired records, not hidden answers. Selecting a row works with keyboard or touch.</p><ul node-id="links"><li node-id="edge" each="component.edges" item-key="id"><strong node-id="edge-label" bind:text="item.label"/><p node-id="edge-text" bind:text="item.text"/></li></ul></aside></div>
   <div node-id="epistemic" class="epistemic"><article node-id="ep-row" each="component.rows" item-key="id"><p node-id="ep-kind" class="semantic" bind:text="item.kind"/><h3 node-id="ep-label" bind:text="item.label"/><p node-id="ep-text" bind:text="item.text"/><small node-id="ep-source" bind:text="item.source"/></article></div>
  </section>
  <section node-id="cases-page" if="component.isCases" class="section"><div node-id="cases-title" class="title-block"><h1 node-id="cases-heading" tabindex="-1">Inquiries, not a checklist</h1><p node-id="cases-intro" class="deck">Follow independent sources. An arrangement changes present rights and duties; it does not settle the deep cause.</p></div>
   <div node-id="case-network" class="case-network" aria-label="Known Case network"><article node-id="case-row" each="component.cases" item-key="id" class="case-file"><p node-id="case-kind" class="semantic" bind:text="item.kind"/><button node-id="selectCase" on:click="inspectCase" class="record-title" bind:text="item.label"/><p node-id="case-text" bind:text="item.text"/><p node-id="case-source" class="source" bind:text="item.source"/><p node-id="case-custody" class="consequence" bind:text="item.custody"/></article></div>
   <section node-id="hearing" class="hearing"><h2 node-id="hearing-title">Eastbank Hearing</h2><p node-id="hearing-intro">Six independent terms. No completion score; no single reveal-or-conceal choice. Only a filed compact changes the terms below.</p><dl node-id="terms" class="terms"><div node-id="term" each="component.terms" item-key="id"><dt node-id="term-label" bind:text="item.label"/><dd node-id="term-value" bind:text="item.text"/></div></dl></section>
  </section>
  <section node-id="identity-page" if="component.isIdentity" class="section"><div node-id="identity-title" class="title-block"><h1 node-id="identity-heading" tabindex="-1">What binds you</h1><p node-id="identity-intro" class="deck">A Seed is a possibility. A formal Claim has an Anchor, a jurisdiction and an enforceable Price.</p></div><p node-id="continuous-identity" class="prose" bind:text="component.identityLife"/><div node-id="status-list" class="status-list"><article node-id="status-row" each="component.status" item-key="id"><p node-id="status-kind" class="semantic" bind:text="item.kind"/><h2 node-id="status-label" bind:text="item.label"/><p node-id="status-text" bind:text="item.text"/><small node-id="status-source" bind:text="item.source"/><p node-id="status-custody" class="consequence" bind:text="item.custody"/></article></div>
   <section node-id="save-section" class="save-section"><h2 node-id="save-heading">Save container</h2><p node-id="save-help">Save the committed session. This is not a journal of unsubmitted or uncertain requests.</p><button node-id="save" bind:disabled="component.writeDisabled">Create save</button><label node-id="save-label" for="save-picker">Saved sessions</label><select node-id="saveSelect" id="save-picker" name="saved-session" autocomplete="off" bind:value="component.saveId"><option node-id="save-empty" value="">Choose a save</option><option node-id="save-option" each="component.saves" item-key="id" bind:value="item.id" bind:text="item.label"/></select><label node-id="restore-confirm" class="check"><input node-id="restore-check" type="checkbox" bind:checked="component.saveConfirm"/>Restore replaces the active branch with this saved state.</label><button node-id="restore" bind:disabled="component.writeDisabled">Restore selected save</button></section>
  </section>
<section node-id="chronicle-page" if="component.isChronicle" class="section"><h1 node-id="chronicle-heading" tabindex="-1" bind:text="component.historyHeading"/><p node-id="long-life-copy-0">Recorded facts, attributed documents and remembered events remain distinct.</p><label node-id="entity-mode-label" if="component.isInstitutions" for="entity-mode">Entity register (used in Institutions &amp; places)</label><select node-id="entityMode" bind:disabled="component.historyBusy" if="component.isInstitutions" id="entity-mode" bind:value="component.entityMode"><option node-id="entity-institutions" value="institutions">Institutions</option><option node-id="entity-places" value="places">Places</option></select><div node-id="history-filters" class="action-fields"><div node-id="historyFacet-field"><label node-id="historyFacet-label" for="historyFacet">Browse by one dimension</label><select node-id="historyFacet" bind:disabled="component.historyBusy" id="historyFacet" bind:value="component.historyFacet"><option node-id="historyFacet-0" value="">Recent history</option><option node-id="historyFacet-1" value="year">Year</option><option node-id="historyFacet-2" value="era">Era</option><option node-id="historyFacet-3" value="actor">Person</option><option node-id="historyFacet-4" value="family">Family</option><option node-id="historyFacet-5" value="institution">Institution</option><option node-id="historyFacet-6" value="location">Place</option><option node-id="historyFacet-7" value="case">Matter</option><option node-id="historyFacet-8" value="claim">Claim</option><option node-id="historyFacet-9" value="artifact">Artifact</option></select></div><div node-id="historyValue-field"><label node-id="historyValue-label" for="historyValue">Year or known entity ID</label><input node-id="historyValue" bind:disabled="component.historyBusy" id="historyValue" bind:value="component.historyValue"/></div><div node-id="historyKind-field"><label node-id="historyKind-label" for="historyKind">Record kind</label><select node-id="historyKind" bind:disabled="component.historyBusy" id="historyKind" bind:value="component.historyKind"><option node-id="historyKind-0" value="">All kinds</option><option node-id="historyKind-1" value="event">Recorded event</option><option node-id="historyKind-2" value="fact">Recorded fact</option><option node-id="historyKind-3" value="summary">Historical summary</option><option node-id="historyKind-4" value="artifact">Attributed artifact</option><option node-id="historyKind-5" value="hook">Historical connection</option></select></div><div node-id="historyId-field"><label node-id="historyId-label" for="historyId">Exact record ID (instead of browse dimension)</label><input node-id="historyId" bind:disabled="component.historyBusy" id="historyId" bind:value="component.historyId"/></div></div><div node-id="history-buttons" class="button-row"><button node-id="historyApply" on:click="historyApplyRead" bind:disabled="component.historyBusy">Apply filters</button><button node-id="historyClear" on:click="historyReadBegin" bind:disabled="component.historyBusy">Clear filters</button></div><p node-id="history-status" role="status" bind:text="component.historyStatus"/><div node-id="history-results" class="history-results"><div node-id="history-list" tabindex="-1" aria-label="Historical results"><article node-id="history-row" each="component.historyRows" item-key="id" class="case-file"><p node-id="history-row-kind" class="semantic" bind:text="item.kind"/><button node-id="historySelect" on:click="historyInspect" bind:disabled="component.historyBusy" class="record-title" bind:text="item.label"/><p node-id="history-row-source" class="source" bind:text="item.source"/></article><button node-id="historyNext" on:click="historyReadBegin" if="component.historyNext" bind:disabled="component.historyBusy">Load next page</button></div><article node-id="history-detail" if="component.historyOpen" class="detail"><button node-id="historyBack">Back to results</button><h2 node-id="chronicle-detail-heading" tabindex="-1" bind:text="component.historyDetail.label"/><p node-id="history-detail-kind" class="semantic" bind:text="component.historyDetail.kind"/><p node-id="history-detail-text" class="prose" bind:text="component.historyDetail.text"/><h3 node-id="history-sources-heading">Date and sources</h3><p node-id="history-detail-source" class="prose" bind:text="component.historyDetail.source"/><p node-id="history-detail-custody" class="prose" bind:text="component.historyDetail.custody"/><div node-id="memory-actions" if="component.historyIsRecord" class="button-row"><button node-id="historyMark" bind:disabled="component.writeDisabled" bind:text="component.historyMark"/><button node-id="historyJournal" bind:disabled="component.writeDisabled">Record in journal</button></div><label node-id="relation-label" for="history-relation">Known related records</label><select node-id="historyRelation" bind:disabled="component.historyBusy" id="history-relation" bind:value="component.historyRelation"><option node-id="relation-empty" value="">Choose a known relation</option><option node-id="relation-option" each="component.historyRelations" item-key="id" bind:value="item.id" bind:text="item.label"/></select><button node-id="historyBrowseRelation" on:click="historyReadBegin" bind:disabled="component.historyBusy">Browse selected relation</button><button node-id="historySources" on:click="historyReadBegin" bind:disabled="component.historyBusy">Browse historical sources</button><p node-id="memory-boundary">Memory marks and journal entries do not edit facts.</p></article></div></section><section node-id="time-page" if="component.isTime" class="section"><h1 node-id="time-heading" tabindex="-1">Time &amp; stances</h1><p node-id="long-life-copy-1">Time may stop early when your attention is required. Review all six stances before confirming. Unsaved values are drafts, not committed policy.</p><p node-id="committed-policy" class="prose" bind:text="component.committedPolicy"/><div node-id="interval-presets" class="button-row"><button node-id="intervalDay">1 day</button><button node-id="intervalMonth">1 month</button><button node-id="intervalYear">1 year</button><button node-id="intervalDecade">10 years</button></div><div node-id="calendar-fields" class="action-fields"><div node-id="intervalQuantity-field"><label node-id="intervalQuantity-label" for="intervalQuantity">Interval quantity</label><input node-id="intervalQuantity" id="intervalQuantity" bind:value="component.quantity"/></div><div node-id="intervalUnit-field"><label node-id="intervalUnit-label" for="intervalUnit">Calendar unit</label><select node-id="intervalUnit" id="intervalUnit" bind:value="component.unit"><option node-id="intervalUnit-0" value="days">Days</option><option node-id="intervalUnit-1" value="months">Months</option><option node-id="intervalUnit-2" value="years">Years</option><option node-id="intervalUnit-3" value="minutes">Exact minutes</option></select></div></div><div node-id="calendar-buttons" class="button-row"><button node-id="intervalPrepare" bind:disabled="component.writeDisabled">Review calendar interval</button><button node-id="intervalRemaining" bind:disabled="component.writeDisabled">Review remaining interval</button><button node-id="stanceOnly" bind:disabled="component.writeDisabled">Prepare stance-only update</button></div><p node-id="interval-review" role="status" bind:text="component.intervalReview"/></section>
  <section node-id="action-panel" if="component.showActions" class="action-panel"><div node-id="action-intro"><h2 node-id="action-heading">Choose your next action</h2><p node-id="action-copy">These are available methods, not a list of discovered clues. The current record determines whether a method is valid.</p></div><label node-id="action-label" for="action-picker">Declared method</label><select node-id="selectAction" id="action-picker" name="declared-method" autocomplete="off" bind:disabled="component.pending" bind:value="component.selected"><option node-id="action-option" each="component.choices" item-key="id" bind:value="item.id" bind:text="item.label"/></select><h3 node-id="actionTitle" bind:text="component.actionTitle"/><div node-id="action-fields" class="action-fields"><!-- FIELDS --></div><p node-id="form-page-label" bind:text="component.formPageLabel"/><div node-id="form-pages" class="button-row"><button node-id="formPrevious" if="component.formHasPrevious" bind:disabled="component.pending">Previous fields</button><button node-id="formNext" if="component.formHasNext" bind:disabled="component.pending">Next fields</button></div><aside node-id="risk" class="risk"><h3 node-id="risk-title">Before you commit</h3><p node-id="risk-copy" bind:text="component.risk"/><p node-id="risk-boundary">Only known qualitative consequences are shown. No hidden odds or random seed is exposed. Native authority checks access, support and deadlines.</p></aside><label node-id="accept" class="check"><input node-id="accept-check" type="checkbox" bind:disabled="component.reviewDisabled" bind:checked="component.accepted"/>I have reviewed the method and its known consequences.</label><p node-id="reviewed-draft" class="prose" bind:text="component.reviewText"/><p node-id="action-status" class="action-status" bind:text="component.notice"/><button node-id="commit" class="primary" bind:disabled="component.blocked" bind:text="component.commitLabel"/></section>
  <details node-id="advisory" class="advisory"><summary node-id="advisory-summary">Reflection and Claim advice</summary><p node-id="advisory-boundary">Advisory only. These tasks read approved views; they cannot apply commands or declare an unseen cause.</p><label node-id="query-label" for="query">Question about the known record</label><textarea node-id="query" id="query" name="advisory-question" autocomplete="off" rows="2" bind:value="component.query"/><div node-id="advice-buttons" class="button-row"><button node-id="reflection" bind:disabled="component.adviceBusy">Case Reflection</button><button node-id="advisor" bind:disabled="component.adviceBusy">Claim Advisor</button></div><p node-id="advice" role="status" class="prose" bind:text="component.advice"/></details>
  <footer node-id="footer">Eastbank field register. The deep cause remains unresolved.</footer>
 </section>
</main>
</template>
