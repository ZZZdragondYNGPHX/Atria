        {
          "knowledgeEntryId": "kentry_6f35a5d5397d88ec57a91c28d5ed4480",
          "content": "A Civil Verifier may request a specific copy with documented interest. This is not a warrant for every archive.",
          "metadata": {
            "sourceDefinitionId": "knowledge.civil_requests",
            "disclosure": "public"
          }
        },
        {
          "knowledgeEntryId": "kentry_19de4ee1637ee3fb5d0446035a87f254",
          "content": "The communion maintains naming, marriage and burial practices. Membership does not grant sacred office or deep theory.",
          "metadata": {
            "sourceDefinitionId": "knowledge.ordinary_rites",
            "disclosure": "public"
          }
        },
        {
          "knowledgeEntryId": "kentry_b6b8d84a761c240d88dc93dd1c22b5a6",
          "content": "Official accounts describe fire, transport disruption, telegraph failure and reconstruction approximately forty years ago. This attributed account is not a complete causal explanation.",
          "metadata": {
            "sourceDefinitionId": "knowledge.public_history",
            "disclosure": "public"
          }
        },
        {
          "knowledgeEntryId": "kentry_9c40d98cd88fde037f5b8faea50ab1e9",
          "content": "A claimant must identify the subject and authority to act. An accepted financial claim does not prove every historical assertion.",
          "metadata": {
            "sourceDefinitionId": "knowledge.claim_procedure",
            "disclosure": "public"
          }
        },
        {
          "knowledgeEntryId": "kentry_515b4a10477c713789a00930debf9e64",
          "content": "Separate witnesses, record time, preserve boundaries and avoid casually moving contradictory relics or records. Escalate persistent identity discrepancies.",
          "metadata": {
            "sourceDefinitionId": "knowledge.safe_inquiry",
            "disclosure": "public"
          }
        },
        {
          "knowledgeEntryId": "kentry_29bdd2d28034da884b976d483cde0191",
          "content": "The city links the Old Quarter, Civic District, Exchange, University Quarter, Industrial Belt and Docks. A ticket does not grant track or warehouse access.",
