{
  "schemaVersion": 2,
  "stateVersion": 1,
  "localState": {
    "name": {
      "type": "string",
      "default": "",
      "scope": "mount"
    }
  },
  "actions": {
    "fill": {
      "steps": [
        {
          "op": "ui.set",
          "path": "ui.name",
          "value": "Atria"
        }
      ]
    }
  },
  "views": [
    {
      "id": "main",
      "surface": "chat.footer",
      "mount": "always",
      "root": {
        "id": "root",
        "type": "container",
        "children": [
          {
            "id": "welcome",
            "type": "text",
            "props": {
              "text": "欢迎来到你的作品"
            }
          },
          {
            "id": "name",
            "type": "input",
            "model": "ui.name",
            "props": {
              "label": "名称"
            }
          },
          {
            "id": "fill",
            "type": "button",
            "props": {
              "text": "填入示例名称"
            },
            "events": {
              "click": "fill"
            }
          }
        ]
      }
    }
  ]
}
