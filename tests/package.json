{
    "name": "atria-tests",
    "type": "module",
    "license": "AGPL-3.0",
    "scripts": {
        "test": "npm run test:unit && npm run test:contracts && npm run test:e2e",
        "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.json",
        "test:unit:serial": "npm run test:unit -- --runInBand",
        "test:e2e": "playwright test --project=e2e",
        "lint": "eslint \"**/*.js\" ./*.js",
        "lint:fix": "eslint \"**/*.js\" ./*.js --fix",
        "test:contracts": "node --import ./util/config.js --test native/*.test.mjs",
        "test:db": "node --input-type=module -e \"if (!process.env.ATRIA_TEST_MYSQL_ROOT_URL && !process.env.ATRIA_TEST_POSTGRES_URL) throw new Error('Set ATRIA_TEST_MYSQL_ROOT_URL or ATRIA_TEST_POSTGRES_URL')\" && npm run test:unit -- --testPathPattern=\"storage|sync\""
    },
    "dependencies": {
        "@playwright/test": "^1.56.1",
        "@types/jest": "^29.5.12",
        "eslint": "^8.57.0",
        "jest": "^29.7.0"
    },
    "devDependencies": {
        "jest-environment-jsdom": "^29.7.0",
        "supertest": "^7.2.2",
        "testcontainers": "^12.0.3"
    }
}
