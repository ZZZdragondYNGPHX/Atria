{
  "schemaVersion": 2,
  "stateVersion": 1,
  "localState": {
    "name": { "type": "string", "default": "", "scope": "session", "required": true, "minLength": 2, "maxLength": 40 },
    "path": { "type": "string", "default": "explorer", "enum": ["explorer", "scholar"] }
  },
  "preferences": { "compact": { "type": "boolean", "default": false, "scope": "player" } },
  "selectors": { "greeting": "concat(\"Welcome, \", ui.name)" },
  "actions": {
    "next": { "steps": [{ "op": "opening.next" }] },
    "back": { "steps": [{ "op": "opening.back" }] },
    "begin": { "steps": [{ "op": "opening.confirm" }] },
    "start": { "steps": [{ "op": "composer.set", "value": { "template": "Name: {{ui.name}}; Path: {{ui.path}}" } }, { "op": "composer.submit" }] },
    "compact": { "steps": [{ "op": "ui.toggle", "path": "prefs.compact" }] }
  },
  "views": [
    { "id": "setup", "surface": "chat.header", "mount": "always", "root": { "id": "setup_form", "type": "form", "events": { "submit": "next" }, "children": [
      { "id": "title", "type": "text", "props": { "text": "Choose your beginning" } },
      { "id": "name", "type": "input", "model": "ui.name", "props": { "label": "Character name", "placeholder": "Your name" } },
      { "id": "path", "type": "select", "model": "ui.path", "props": { "label": "Path", "options": [{ "value": "explorer", "label": "Explorer" }, { "value": "scholar", "label": "Scholar" }] } },
      { "id": "next", "type": "button", "props": { "text": "Review", "submit": true } }
    ] } },
    { "id": "review", "surface": "chat.footer", "mount": "always", "root": { "id": "review_form", "type": "form", "events": { "submit": "begin" }, "children": [
      { "id": "greeting", "type": "text", "bindings": { "text": { "expr": "selectors.greeting" } } },
      { "id": "back", "type": "button", "props": { "text": "Back" }, "events": { "click": "back" } },
      { "id": "begin", "type": "button", "props": { "text": "Start story", "submit": true } }
    ] } },
    { "id": "catalog", "surface": "composer.after", "mount": "always", "root": { "id": "catalog_root", "type": "stack", "children": [
      { "id": "compact", "type": "button", "props": { "text": "Toggle compact view" }, "events": { "click": "compact" } },
      { "id": "items", "type": "repeat", "source": "data.items", "key": "item.id", "pageSize": 2, "emptyText": "No items", "children": [
        { "id": "item", "type": "text", "bindings": { "text": { "expr": "item.name" } } }
      ] }
    ] } }
  ],
  "opening": { "initial": "setup", "confirmAction": "start", "steps": [
    { "id": "setup", "view": "setup", "fields": ["ui.name", "ui.path"], "next": [{ "when": "length(ui.name) >= 2", "to": "review" }] },
    { "id": "review", "view": "review", "fields": ["ui.name", "ui.path"], "next": [] }
  ] }
}
