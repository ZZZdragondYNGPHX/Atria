<aside node-id="panel-drawer" bind:class="component.panelScaleClass" style:panelHeight="component.panelHeight" if="component.panelOpen" aria-label="游戏资料与行动">
  <header node-id="panel-header" class="panel-header"><div node-id="panel-heading-wrap"><h2 node-id="panel-title" bind:text="component.panelTitle" /></div><button node-id="panel-close" aria-label="关闭资料，返回场景">返回场景</button></header>
  <div node-id="panel-scroll" class="panel-scroll">

    <img node-id="panel-world-image" class="panel-world-image" if="component.panelWorld" asset="map-first-regions" alt="乌坦城、青山镇与魔兽山脉的手绘地域示意；可旅行目的地以已知地点列表为准" />
    <div node-id="panel-section-tabs" class="panel-button-row" if="component.panelCharacterTabs"><button node-id="panel-open-growth">功法修行</button><button node-id="panel-open-body">身体器物</button><button node-id="panel-open-relations">人物关系</button></div>
    <div node-id="panel-character-art" class="panel-character-art" if="component.panelBody"><img node-id="self-portrait" if="component.scenePlayerHasImage" bind:media="component.panelPortrait" alt="你的立绘" /></div>
    <p node-id="panel-summary" class="panel-summary" bind:text="component.panelSummary" />
    <div node-id="panel-operation-controls" class="panel-operation" if="component.panelHasOperation"><p node-id="panel-operation-text" bind:text="component.panelOperation" /><div node-id="panel-operation-buttons" class="panel-button-row"><button node-id="panel-continue" bind:disabled="component.busy">继续当前活动</button><button node-id="panel-cancel" bind:disabled="component.busy">停止后续计划</button></div></div>
    <div node-id="panel-controls" class="panel-controls">
      <section node-id="panel-growth-controls" if="component.panelGrowth" class="panel-form-section">
        <label node-id="panel-days-label" for="doupo-panel-days">天数</label><input node-id="panel-days" id="doupo-panel-days" type="text" inputmode="numeric" bind:value="component.panelDays" />
        <div node-id="panel-growth-buttons" class="panel-button-row"><button node-id="panel-train" bind:disabled="component.busy">闭关修炼</button><button node-id="panel-rest" bind:disabled="component.busy">休息疗养</button><button node-id="panel-wait" bind:disabled="component.busy">等候时日</button><button node-id="panel-work" bind:disabled="component.busy">谋生做工</button><button node-id="panel-breakthrough" bind:disabled="component.busy">尝试突破</button><button node-id="panel-refine" bind:disabled="component.busy">炼制疗伤散</button></div>

      </section>
      <section node-id="panel-inventory-controls" if="component.panelInventory" class="panel-form-section">
        <label node-id="panel-qty-label" for="doupo-panel-qty">数量</label><input node-id="panel-qty" id="doupo-panel-qty" type="text" inputmode="numeric" bind:value="component.panelQty" />

      </section>
      <section node-id="panel-relations-controls" if="component.panelRelations" class="panel-form-section">
        <div node-id="people-filter" class="panel-button-row"><button node-id="panel-nearby">附近人物</button><button node-id="panel-known">已知旧档案</button></div><strong node-id="panel-target-label" bind:text="component.panelTargetLabel" />
        <div node-id="panel-social-buttons" class="panel-button-row"><button node-id="panel-social-talk" bind:disabled="component.busy">写下想说的话</button><button node-id="panel-social-invite" bind:disabled="component.busy">邀请同行</button><button node-id="panel-social-promise" bind:disabled="component.busy">回应当前所需</button><button node-id="panel-social-deliver" bind:disabled="component.busy">履行约定</button><button node-id="panel-social-care" bind:disabled="component.busy">照护对方</button><button node-id="panel-social-confess" bind:disabled="component.busy">表达心意</button><button node-id="panel-social-engage" bind:disabled="component.busy">商议婚约</button><button node-id="panel-social-marry" bind:disabled="component.busy">建立家庭</button><button node-id="panel-social-conceive" bind:disabled="component.busy">商议养育</button><button node-id="panel-social-separate" bind:disabled="component.busy">结束共同生活</button></div>
        <label node-id="panel-letter-label" for="doupo-letter">书信</label><textarea node-id="panel-letter" id="doupo-letter" bind:value="component.panelLetter" rows="3" placeholder="写给当前所选人物……" /><button node-id="panel-send-letter" bind:disabled="component.busy">寄信 · 邮资一金</button><button node-id="panel-release" bind:disabled="component.busy">释放看守对象</button>
        <label node-id="panel-item-label" for="doupo-panel-item">赠礼</label><select node-id="panel-item" id="doupo-panel-item" bind:value="component.panelItem"><option node-id="panel-item-food" value="food">干粮</option><option node-id="panel-item-herb" value="herb">常用药草</option><option node-id="panel-item-medicine" value="medicine">基础疗伤散</option><option node-id="panel-item-manual" value="manual">基础功法抄本</option><option node-id="panel-item-technique" value="technique">碎石掌抄本</option><option node-id="panel-item-formula" value="formula">疗伤散丹方</option><option node-id="panel-item-redleaf" value="redleaf">赤叶药材</option><option node-id="panel-item-relic" value="relic">修炼札记</option></select><button node-id="panel-social-gift" bind:disabled="component.busy">赠与一份</button>
        <label node-id="panel-skill-label" for="doupo-panel-skill">传授技艺</label><select node-id="panel-skill" id="doupo-panel-skill" bind:value="component.panelSkill"><option node-id="panel-skill-basic" value="basic">基础功法</option><option node-id="panel-skill-palm" value="palm">碎石掌</option><option node-id="panel-skill-formula" value="formula">基础丹方</option><option node-id="panel-skill-refining" value="refining">炼药控火</option></select><button node-id="panel-social-teach" bind:disabled="component.busy">投入一日传授</button>
      </section>
      <section node-id="panel-clues-controls" if="component.panelClues" class="panel-button-row"><button node-id="nav-activity">行程记录</button><button node-id="panel-investigate" bind:disabled="component.busy">调查当前位置</button><button node-id="panel-gather" bind:disabled="component.busy">采集常用药草</button></section>
      <section node-id="panel-combat-controls" if="component.panelCombat" class="panel-form-section"><strong node-id="panel-combat-target" bind:text="component.panelTargetLabel" /><div node-id="panel-tactics" class="panel-button-row"><button node-id="panel-attack" bind:disabled="component.busy">攻击</button><button node-id="panel-technique" bind:disabled="component.busy" bind:text="component.panelTechniqueName" /><button node-id="panel-guard" bind:disabled="component.busy">防守</button><button node-id="panel-retreat" bind:disabled="component.busy">尝试撤退</button><button node-id="panel-surrender" bind:disabled="component.busy">投降</button><button node-id="panel-consume" bind:disabled="component.busy">服用疗伤散</button></div></section>
      <section node-id="panel-save-controls" if="component.panelSaves" class="panel-form-section"><label node-id="panel-save-name-label" for="doupo-panel-save-name">新存档名称（可留空）</label><input node-id="panel-save-name" id="doupo-panel-save-name" bind:value="component.panelSaveName" placeholder="为这一刻留个名字" /><div node-id="panel-save-actions" class="panel-button-row"><button node-id="panel-save" bind:disabled="component.busy">保存当前世界</button><button node-id="panel-saves-refresh">刷新存档列表</button><button node-id="panel-saves-more" if="component.panelSaveMore">下一页存档</button></div></section>
    </div>
    <section node-id="panel-host-controls" if="component.panelHost" class="panel-form-section"><p node-id="panel-generation-state" bind:text="component.panelGeneration" /><div node-id="panel-host-buttons" class="panel-button-row"><button node-id="panel-stop">停止生成</button><button node-id="panel-refresh">核对当前结果</button><button node-id="panel-font-normal">标准文字</button><button node-id="panel-font-large">放大文字</button><button node-id="panel-host-saves">存档与恢复</button><button node-id="panel-reload">重新载入画面</button><button node-id="panel-recover">恢复宿主</button><button node-id="panel-exit">退出作品</button></div><p node-id="panel-host-settings-note" class="panel-note">模型、声音与账户：使用 Atria 系统设置</p></section>
    <p node-id="panel-page-label" class="panel-note" bind:text="component.panelPageLabel" />
    <div node-id="panel-pagination" class="panel-button-row" if="component.panelClues"><button node-id="panel-prev" bind:disabled="component.panelPrevDisabled">上一页见闻</button><button node-id="panel-next" bind:disabled="component.panelNextDisabled">下一页见闻</button></div>
    <div node-id="panel-people-pagination" class="panel-button-row" if="component.panelRelations"><button node-id="panel-people-prev" bind:disabled="component.panelPrevDisabled">上一页人物</button><button node-id="panel-people-next" bind:disabled="component.panelNextDisabled">下一页人物</button></div>
    <div node-id="panel-row-events" class="panel-row-events"><article node-id="panel-row" bind:class="item.className" each="component.panelRows" item-key="id"><img node-id="panel-item-image" class="panel-item-image" if="item.hasImage" bind:media="item.image" alt="" /><div node-id="panel-row-content" class="panel-row-content"><h3 node-id="panel-row-title" bind:text="item.title" /><p node-id="panel-row-text" bind:text="item.text" /><small node-id="panel-row-meta" bind:text="item.meta" /></div><div node-id="panel-row-buttons" class="panel-button-row"><button node-id="panel-row-primary" if="item.primary" bind:text="item.primary" bind:data-value="item.primaryValue" bind:disabled="item.disabled" /><button node-id="panel-row-secondary" if="item.secondary" bind:text="item.secondary" bind:data-value="item.secondaryValue" bind:disabled="item.disabled" /></div></article></div>
    <p node-id="panel-empty" class="panel-empty" if="component.panelEmpty" bind:text="component.panelEmptyText" />
    <section node-id="panel-confirm" class="panel-confirm" if="component.panelConfirm" aria-label="确认这项安排"><h3 node-id="panel-confirm-title" bind:text="component.panelConfirmTitle" /><p node-id="panel-confirm-text" bind:text="component.panelConfirmText" /><div node-id="panel-confirm-buttons" class="panel-button-row"><button node-id="panel-confirm-back">返回修改</button><button node-id="panel-confirm-accept" bind:disabled="component.panelConfirmDisabled">确认提交</button></div></section>
    <p node-id="panel-error" class="panel-error" role="status" aria-live="polite" bind:text="component.panelError" />
  </div>
</aside>
